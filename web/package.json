{
  "name": "flowy-console",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "The Flowy console: chat, threads and artifacts over the node's HTTP API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"require('node:fs').writeFileSync('dist/.gitkeep', '')\"",
