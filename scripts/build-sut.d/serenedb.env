# SereneDB: build serened at a commit, in serenedb's own toolchain image with its own CI script.
#
# This is the project the repro service was written against, and these values are the ones the
# original hardcoded build-sut.sh carried, moved out of the script unchanged so that a build run
# through the ported script is the same build that ran before. It doubles as the worked example for
# what a second project's file has to say.
#
# Not a shell program - build-sut.sh sources it, and anything the caller already exported wins over
# what is set here, so a one-off can be run against a different scratch area or toolchain image
# without editing this file.

# Source tree with the submodules already checked out. The build reuses those local checkouts
# instead of cloning llvm-project and friends over the network for every commit.
SUT_SRC_REPO=/home/dead/Projects/serenedb/serenedb-main

# SereneDB publishes the image its own CI compiles in, so there is no toolchain to reconstruct here.
SUT_BUILD_IMAGE=serenedb/serenedb-build-ubuntu:latest

# The same invocation CI uses. The source is mounted at /serenedb, so the script is named absolutely
# and does not depend on the container's working directory.
SUT_SRC_MOUNT=/serenedb
SUT_BUILD_CMD="/serenedb/scripts/ci/build.bash serened"
SUT_ARTIFACT=build/bin/serened
SUT_BIN_NAME=serened

# RelWithDebInfo with debug info kept, because a repro that crashes is worth a usable backtrace.
# The dev, fault-injection and gtest switches are off: this binary is a system under test, not a
# development build, and IPO is off because it costs far more compile time than it buys here.
SUT_BUILD_ENV="BUILD_DIR=build BUILDMODE=RelWithDebInfo USE_DEBUG_INFO=On SDB_DEV=Off SDB_FAULT_INJECTION=Off SDB_GTEST=Off USE_IPO=Off"

# The build runs a debugger-adjacent test step, so it needs ptrace and an unconfined seccomp profile.
SUT_DOCKER_ARGS="--cap-add=SYS_PTRACE --security-opt seccomp=unconfined"

# Submodule population through a linked worktree reports a benign failure after it has already
# checked the files out, so its exit code cannot be trusted. These are the dependencies whose absence
# actually breaks the compile, and finding one of them empty is the real signal.
SUT_REQUIRE_PATHS="third_party/llvm-project third_party/postgres third_party/re2 third_party/fmt third_party/abseil-cpp third_party/faiss"

# Kept unsuffixed rather than taking the per-project default of handoff-ccache-serenedb, so the warm
# ccache the original script has been filling since it was written is still the one used.
SUT_CCACHE_VOL=handoff-ccache
SUT_SCRATCH=/mnt/data/handoff-build
