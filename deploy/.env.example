# Copy to .env and fill in. bootstrap.sh does this for you on a fresh machine,
# generating the password rather than asking you to invent one.
#
# .env is gitignored: it holds the database password, and a deployment secret in
# the repository is a secret in everyone's clone.

# The name this node stamps onto every row it writes. Peers decide merges
# against it, so pick one and keep it: renaming a live node splits its history
# from the rows it already wrote. No default on purpose.
FLOWY_NODE=flowy1

# The Postgres credential. Any long random string; nothing outside the internal
# network can reach the database in the first place.
FLOWY_DB_PASSWORD=

# Optional. Left at the defaults these need no line here.
#FLOWY_DB_USER=flowy
#FLOWY_DB_NAME=flowy

# The user id that may use ?scope=all on this node. bootstrap.sh writes the id
# of the seat it mints. Empty means the node has no operator, which refuses the
# scope rather than breaking anything.
FLOWY_OPERATOR=

# Comma-separated user ids whose token may push replication deltas at this node.
FLOWY_PEERS=

# Issue tracker for the forge bridge: gh, glab, mock, or empty to use whichever
# CLI is installed. The image ships neither CLI, so on a container deployment
# this is either empty or mock until one is added.
FLOWY_FORGE=

# The host port compose.loopback.yaml publishes on 127.0.0.1.
FLOWY_PORT=8787

# The commit the image was built from, reported by `flowy version`.
# bootstrap.sh fills it in from git.
FLOWY_BUILD_STAMP=

# ---------------------------------------------------------------- the runner
#
# Only handoff-runner.compose.yaml reads these; the node deployment ignores
# them. They are in the same file because both halves talk to the same database
# and a second copy of that credential is a copy that goes stale.

# The project's source checkout on this host: build-sut.sh checks commits out of
# it through a worktree, so it must be a real clone and it must be writable.
# Bound into the runner at the same path, so paths in a generated compose
# package resolve on both sides.
#
# THE MAIN CLONE, not a linked worktree. A worktree's .git is a file pointing at
# the main clone's git directory somewhere else, which would not be mounted, so
# every git command inside the container fails naming a path that is not there.
# handoff-runner.sh refuses that case and names the clone to use instead.
SUT_SRC_REPO=/home/dead/Projects/serenedb/serenedb

# Working area for worktrees and the sha-keyed binary cache. A cold build of a
# real database is measured in hours, so this wants to be on a disk with room
# and it wants to survive a redeploy.
SUT_SCRATCH=/mnt/data/handoff-build

# Where build-sut.sh looks up a project's build recipe: one NAME.env per
# project, the shape scripts/build-sut.d/serenedb.env documents. The image bakes
# the repository's copy in; point this at a bind mount to add a project without
# rebuilding.
SUT_CONFIG_DIR=/opt/flowy/scripts/build-sut.d

# The runner's own command line, in one line on purpose. cmd/handoff-runner is
# piece 9 and its flags are not settled here - when they are, this is the single
# edit that wires them, and nothing else in the deployment changes.
HANDOFF_RUNNER_ARGS=
