#!/usr/bin/env bash
# CAN THIS MACHINE RUN THIS PROJECT'S GATE - asked by the project, because the
# answer is about the project's requirements and not about a universal
# definition of a machine that can run tests. 01M0DZPFQD.
#
# pre-gate.sh keeps the questions that are about the QUEUE - is the row still
# admissible, is the lock mine, would a declaration from me be taken - which it
# asks of the node. The machine half is this, and it moved here because
# `initdb`, `pg_ctl` and llvmjit are flowy's requirements. A project with no
# database has no business being refused a run over a missing Postgres.
#
# THE CONTRACT. One finding per line on stdout:
#
#   ok  <what is true>
#   bad <what is wrong, and the command that fixes it>
#
# Exit 0 when everything is ok, 1 when anything is bad. The exit code is what
# pre-gate acts on; the lines are what it shows a reader, in the same shape as
# its own checks, so a refusal reads the same whichever half produced it.
#
# A `bad` line may run to several lines - a fix worth printing is worth printing
# whole - and everything after the first is indented, which is how pre-gate
# already formats its own.
set -euo pipefail

fail=0
ok() { printf 'ok  %s\n' "$1"; }
bad() {
	printf 'bad %s\n' "$1"
	fail=1
}

PGBIN=${FLOWY_PG_BIN:-$HOME/.local/pg17-bin}
PGLIB=${FLOWY_PG_LIB:-$HOME/.local/pg17-libs}

# AS THE SUITE WILL SEE IT, not as this script could arrange it.
#
# Measured 2026-08-18: this check ran initdb by its absolute path with
# LD_LIBRARY_PATH set locally and reported ok, and the gate then died in two
# seconds with "no initdb/pg_ctl found" - because run-tests.sh searches PATH,
# and PATH belongs to whoever invoked it. An instrument that arranges the
# conditions it is testing reports on itself.
#
# .flowy-gate puts $PGBIN on PATH, so that is the PATH this asks about.
if PATH="$PGBIN:$PATH" command -v initdb >/dev/null 2>&1 &&
	PATH="$PGBIN:$PATH" command -v pg_ctl >/dev/null 2>&1; then
	ok "initdb and pg_ctl are where the suite looks"
else
	bad "no initdb/pg_ctl in $PGBIN or on PATH - the suite exits in two seconds.
    Install Postgres 17, or point FLOWY_PG_BIN at it"
fi

# INSTALLED IS NOT RUNNABLE. libLLVM.so.19.1 went missing on this host on
# 2026-08-18 and four metrics checks failed on a tree that was fine, twice.
if [ -x "$PGBIN/initdb" ]; then
	if LD_LIBRARY_PATH="$PGLIB" "$PGBIN/initdb" --version >/dev/null 2>&1; then
		ok "initdb starts with its libraries on $PGLIB"
	else
		bad "initdb will not start - check FLOWY_PG_LIB=$PGLIB"
	fi
fi

# THE JIT MODULE IS THE ONE THAT FAILS AS A WRONG ANSWER rather than as an
# error: an unresolved library there fails the expensive queries, so a red looks
# like a problem with the diff.
jit=$(find /usr/lib/postgresql -name llvmjit.so -type f 2>/dev/null | head -1)
if [ -n "$jit" ]; then
	if ldd "$jit" 2>/dev/null | grep -q 'not found'; then
		bad "$(basename "$jit") has an unresolved library - expensive queries will fail, not the diff"
	else
		ok "the postgres jit module resolves its libraries"
	fi
fi

# THE SUITE CANNOT CATCH THE SUITE NOT STARTING. On 2026-08-18 a commit dropped
# run-tests.sh from 100755 to 100644 and every gate that day passed, because an
# existing worktree keeps the mode it was checked out with and `bash file.sh`
# ignores the bit. Only a FRESH worktree exec'ing it sees "Permission denied",
# which reads as a broken sandbox rather than as a file mode.
#
# .flowy-gate execs ./run-tests.sh, so both bits matter and both are asked
# about by name.
for f in .flowy-gate run-tests.sh; do
	if [ -x "$f" ]; then
		ok "$f is executable"
	else
		bad "$f is not executable ($(stat -c %a "$f" 2>/dev/null || echo missing)) - a fresh worktree cannot ./run it.
    git update-index --chmod=+x $f"
	fi
done

# UNFORMATTED WEB CODE, ASKED HERE BECAUSE THE SUITE ANSWERS IT TOO LATE.
# 01M3BG0YJKFKB0N7T45QRYPXMQ.
#
# Measured by flowy-claude over 289 drain passes with a verdict: 77 red, and
# `biome check web/` is 34 of the 77 - 44% of every red this box has produced. It
# never flips. Across every row+tip gated more than once, the pairs where biome
# failed and the same unchanged tip later passed number zero. It is an agent
# filing unformatted code, every time.
#
# The suite already catches it at check 11 of 769, inside the first minute, and
# then keeps going - deliberately, so one run reports every problem rather than
# the first one. So the answer is known at minute one and delivered after the
# whole suite: on drain-01M1RWCHPZ0V98T59T0WGVQYA9-72a123b, 843 checks ran to
# report `passed: 842 failed: 1`. Each occurrence spends a full gate and the
# target lock to learn something that was true before it started.
#
# THIS CHECK FAILS OPEN, WHICH IS BACKWARDS FROM EVERY OTHER CHECK IN THIS FILE,
# and the asymmetry is the reason.
#
# Pre-gate runs BEFORE the suite's npm ci, so the biome it can reach is the one
# the LAST gate installed. A branch that bumps the pin would be judged by the old
# version, and two formatters disagreeing about what is clean is a defect this
# repo has already paid for twice - 01M0JW6GCY for shfmt, 01M37RE102B6R5EG142K711BWZ
# for gofmt. Refusing on that disagreement would turn an optimisation into a red
# somebody's branch did not earn.
#
# The suite is still the authority and will still catch it. So: refuse only when
# this can establish that its biome is the pinned one, and otherwise say why it
# could not and pass. "Could not check, proceeding" is a check failing open
# everywhere else on this board; it is right here, and only here, because a
# second authority exists downstream.
if [ -d web ]; then
	# THE PIN, AS package.json STATES IT. ^1.9.4 is a range, so the test is the
	# major-minor-patch the range names rather than an exact string - an
	# installed 1.9.5 satisfies ^1.9.4 and is not the same formatter. Compared
	# as "same minor line", which is what biome's own compatibility promise
	# covers, and anything outside it declines rather than refuses.
	# `|| true` ON BOTH, AND THE SECOND ONE IS LOAD-BEARING. This file runs under
	# `set -euo pipefail`, so an absent biome makes `npx --no-install` exit
	# non-zero, fails the pipeline, and kills the whole pre-gate - which is exit
	# 1 with no bad line and no explanation, and the drainer refuses the run.
	# Measured by moving web/node_modules aside: exit 1, zero `bad` lines, not
	# one word about biome. A check written to fail open that takes the gate down
	# when its tool is missing is the opposite of what it says it is.
	want=$(sed -n 's/.*"@biomejs\/biome": *"[^0-9]*\([0-9][0-9.]*\)".*/\1/p' web/package.json 2>/dev/null | head -1 || true)
	have=$(cd web && npx --no-install @biomejs/biome --version 2>/dev/null |
		sed -n 's/.*[Vv]ersion: *\([0-9][0-9.]*\).*/\1/p' | head -1 || true)
	if [ -z "$have" ]; then
		ok "biome is not installed in this worktree yet, so formatting is the suite's to judge"
	elif [ -z "$want" ]; then
		ok "web/package.json states no biome version this could hold $have to - leaving formatting to the suite"
	elif [ "${want%.*}" != "${have%.*}" ]; then
		ok "biome here is $have and web/package.json asks for $want - a different minor line, so formatting is the suite's to judge"
	elif (cd web && npx --no-install @biomejs/biome check . >/dev/null 2>&1); then
		ok "web/ is biome $have clean, which is 44% of this box's historical reds not happening"
	else
		# The diff itself, not just the verdict: a refusal that says "reformat
		# it" costs the reader the run they just lost plus a command to find out
		# what. Capped, because biome on a badly formatted tree can print more
		# than a queue message should carry.
		bad "web/ is not biome clean, and the suite would spend a full gate to tell you the same thing.
    cd web && npx @biomejs/biome check --write .
$(cd web && npx --no-install @biomejs/biome check . 2>&1 | head -20 | sed 's/^/    /')"
	fi
fi

exit "$fail"
