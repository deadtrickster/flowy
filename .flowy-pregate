#!/usr/bin/env bash
# CAN THIS MACHINE RUN THIS PROJECT'S GATE - asked by the project, because the
# answer is about the project's requirements and not about a universal
# definition of a machine that can run tests. 01M0DZPFQD.
#
# pre-gate.sh keeps the questions that are about the QUEUE - is the row still
# admissible, is the lock mine, would a declaration from me be taken - which it
# asks of the node. The machine half is this, and it moved here because
# `initdb`, `pg_ctl` and llvmjit are flowy's requirements. A project with no
# database has no business being refused a run over a missing Postgres.
#
# THE CONTRACT. One finding per line on stdout:
#
#   ok  <what is true>
#   bad <what is wrong, and the command that fixes it>
#
# Exit 0 when everything is ok, 1 when anything is bad. The exit code is what
# pre-gate acts on; the lines are what it shows a reader, in the same shape as
# its own checks, so a refusal reads the same whichever half produced it.
#
# A `bad` line may run to several lines - a fix worth printing is worth printing
# whole - and everything after the first is indented, which is how pre-gate
# already formats its own.
set -euo pipefail

fail=0
ok() { printf 'ok  %s\n' "$1"; }
bad() {
	printf 'bad %s\n' "$1"
	fail=1
}

PGBIN=${FLOWY_PG_BIN:-$HOME/.local/pg17-bin}
PGLIB=${FLOWY_PG_LIB:-$HOME/.local/pg17-libs}

# AS THE SUITE WILL SEE IT, not as this script could arrange it.
#
# Measured 2026-08-18: this check ran initdb by its absolute path with
# LD_LIBRARY_PATH set locally and reported ok, and the gate then died in two
# seconds with "no initdb/pg_ctl found" - because run-tests.sh searches PATH,
# and PATH belongs to whoever invoked it. An instrument that arranges the
# conditions it is testing reports on itself.
#
# .flowy-gate puts $PGBIN on PATH, so that is the PATH this asks about.
if PATH="$PGBIN:$PATH" command -v initdb >/dev/null 2>&1 &&
	PATH="$PGBIN:$PATH" command -v pg_ctl >/dev/null 2>&1; then
	ok "initdb and pg_ctl are where the suite looks"
else
	bad "no initdb/pg_ctl in $PGBIN or on PATH - the suite exits in two seconds.
    Install Postgres 17, or point FLOWY_PG_BIN at it"
fi

# INSTALLED IS NOT RUNNABLE. libLLVM.so.19.1 went missing on this host on
# 2026-08-18 and four metrics checks failed on a tree that was fine, twice.
if [ -x "$PGBIN/initdb" ]; then
	if LD_LIBRARY_PATH="$PGLIB" "$PGBIN/initdb" --version >/dev/null 2>&1; then
		ok "initdb starts with its libraries on $PGLIB"
	else
		bad "initdb will not start - check FLOWY_PG_LIB=$PGLIB"
	fi
fi

# THE JIT MODULE IS THE ONE THAT FAILS AS A WRONG ANSWER rather than as an
# error: an unresolved library there fails the expensive queries, so a red looks
# like a problem with the diff.
jit=$(find /usr/lib/postgresql -name llvmjit.so -type f 2>/dev/null | head -1)
if [ -n "$jit" ]; then
	if ldd "$jit" 2>/dev/null | grep -q 'not found'; then
		bad "$(basename "$jit") has an unresolved library - expensive queries will fail, not the diff"
	else
		ok "the postgres jit module resolves its libraries"
	fi
fi

# THE SUITE CANNOT CATCH THE SUITE NOT STARTING. On 2026-08-18 a commit dropped
# run-tests.sh from 100755 to 100644 and every gate that day passed, because an
# existing worktree keeps the mode it was checked out with and `bash file.sh`
# ignores the bit. Only a FRESH worktree exec'ing it sees "Permission denied",
# which reads as a broken sandbox rather than as a file mode.
#
# .flowy-gate execs ./run-tests.sh, so both bits matter and both are asked
# about by name.
for f in .flowy-gate run-tests.sh; do
	if [ -x "$f" ]; then
		ok "$f is executable"
	else
		bad "$f is not executable ($(stat -c %a "$f" 2>/dev/null || echo missing)) - a fresh worktree cannot ./run it.
    git update-index --chmod=+x $f"
	fi
done

exit "$fail"
