# build output; the gate rebuilds it every run
/flowy
/smoke
*.test

# the console's build output and its dependencies. web/dist is embedded into the
# binary, so the directory itself has to exist for go:embed to have a pattern to
# match - .gitkeep is tracked and everything vite writes next to it is not.
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep

# the harness writes these into the project root while it runs the gate
.firecode-*
